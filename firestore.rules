rules_version = '2';

// NES Canvas — regras simples e completas.
// - Qualquer utilizador AUTENTICADO lê/escreve tudo (cobre todas as coleções,
//   incluindo rosters, attendance, payments, studentMeta e notifications).
// - settings e users têm leitura pública (necessária antes do login).
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    match /settings/{doc} { allow read: if true; }
    match /users/{doc}    { allow read: if true; }
  }
}
